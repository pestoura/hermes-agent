        <!-- ===== Edges: relationships ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=-1;" source="user" target="shell" edge="1">
