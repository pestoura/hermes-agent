<mxfile host="github.com" modified="2026-07-31T17:00:00Z" agent="blitzhub-cra-solution-architect" version="26.0.0" etarget="svg">
  <diagram name="C4 Container - CRA Navigator" id="c4-container">
    <mxGraphModel dx="1324" dy="854" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fanning="0" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== System Boundary: BlitzHub CRA Navigator (local desktop) ===== -->
        <mxCell id="nav-boundary" value="BlitzHub CRA Navigator (Windows desktop)" style="gradientColor=#333333;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="860" height="680" as="geometry"/>
        </mxCell>

        <!-- ===== Container: Application Shell (Electron) ===== -->
        <mxCell id="shell" value="Application Shell&#xa;(Electron main + preload)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalLabelPosition=bottom;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="260" height="120" as="geometry"/>
        </mxCell>

        <!-- ===== Container: UI Renderer (Renderer process) ===== -->
        <mxCell id="ui" value="UI Renderer&#xa;(Chromium/React)&#xa;[trust boundary: remote/user]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="260" height="120" as="geometry"/>
        </mxCell>

        <!-- ===== Container: Domain Engine (Node service in Electron) ===== -->
        <mxCell id="domain" value="Domain Engine&#xa;(Node service / IPC)&#xa;[pure, no I/O side effects]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="260" height="120" as="geometry"/>
        </mxCell>

        <!-- ===== Container: Rules Engine ===== -->
        <mxCell id="rules" value="Rules Engine&#xa;(deterministic CRA rules)&#xa;[source of truth: Issue #3/#4]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="340" width="260" height="120" as="geometry"/>
        </mxCell>

        <!-- ===== Container: Local Encrypted Store ===== -->
        <mxCell id="store" value="Local Store&#xa;(SQLCipher + filesystem)&#xa;[at-rest encryption]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- ===== Container: Evidence Vault ===== -->
        <mxCell id="vault" value="Evidence Vault&#xa;(sandboxed filesystem)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="210" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- ===== Container: Report Generator ===== -->
        <mxCell id="report" value="Report Generator&#xa;(static, deterministic)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="340" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- ===== AI Assistant (external to trust boundary) ===== -->
        <mxCell id="ai" value="AI Assistant&#xa;(optional, local LLM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="480" y="480" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- ===== Update Service (external to app boundary in MVP) ===== -->
        <mxCell id="updates" value="Update Service&#xa;(GitHub Releases check)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- ===== User (external actor) ===== -->
        <mxCell id="user" value="SME / manufacturer" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="10" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== External Regulated Body (future cloud boundary) ===== -->
        <mxCell id="regbody" value="Regulated body / market surveillance" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="480" width="220" height="80" as="geometry"/>
