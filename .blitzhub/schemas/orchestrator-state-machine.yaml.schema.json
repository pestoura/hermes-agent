{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pestoura/blitzhub-cra-navigator/.blitzhub/schemas/orchestrator-state-machine.yaml.schema.json",
  "title": "BlitzHub CRA Orchestrator State Machine Spec",
  "description": "JSON Schema for the machine-readable state machine specification that controls the CRA Product Orchestrator. Validates the YAML file at docs/architecture/orchestrator-state-machine.yaml before it is consumed by the executable test suite.",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "description",
    "state_machine"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of this specification schema.",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title of the state machine.",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Long-form description of the state machine's purpose and scope."
    },
    "documentation": {
      "type": "array",
      "description": "List of reference documents for this specification.",
      "items": {
        "type": "string"
      }
    },
    "state_machine": {
      "type": "object",
      "required": [
        "initial_state",
        "states",
        "events",
        "transitions",
        "guards",
        "actions",
        "work_item_flow",
        "kanban_mapping",
        "dispatch_policy",
        "supervisory_integration",
        "conflict_resolution",
        "retry_policy",
        "findings_states",
        "dead_letter",
        "scenarios"
      ],
      "properties": {
        "initial_state": {
          "type": "string",
          "description": "The state the machine starts in when no prior state exists.",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "description": "All states in the state machine.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind",
              "kanban_column"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique machine-readable state identifier.",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "description": "Human-readable state name.",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "description": "Category of state.",
                "enum": [
                  "operational",
                  "terminal",
                  "terminal_external",
                  "interruption",
                  "retry_waiting",
                  "needs_attention",
                  "dead_letter",
                  "containment_required"
                ]
              },
              "kanban_column": {
                "type": "string",
                "description": "The Kanban column that corresponds to this state.",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "description": "Optional description of the state's meaning."
              },
              "entry_actions": {
                "type": "array",
                "description": "Actions executed when entering this state.",
                "items": {
                  "type": "string"
                }
              },
              "exit_actions": {
                "type": "array",
                "description": "Actions executed when exiting this state.",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "events": {
          "type": "array",
          "description": "All events that can trigger transitions.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique machine-readable event identifier.",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "description": "Human-readable event name.",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Category of event source.",
                    "enum": [
                      "github",
                      "supervisory",
                      "internal",
                      "agent_runtime"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "description": "Optional description of what triggers this event."
              }
            },
            "additionalProperties": false
          }
        },
        "transitions": {
          "type": "array",
          "description": "All state transitions.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "from",
              "to",
              "on",
              "guard",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique transition identifier.",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "description": "Source state id or 'any' for catch-all."
              },
              "to": {
                "type": "string",
                "description": "Destination state id."
              },
              "on": {
                "type": "string",
                "description": "Event id that triggers this transition."
              },
              "guard": {
                "type": "array",
                "description": "List of guard ids that must all pass. Use ['any'] or [] for no guards.",
                "items": {
                  "type": "string"
                }
              },
              "action": {
                "type": "array",
                "description": "List of action ids to execute on this transition.",
                "items": {
                  "type": "string"
                }
              },
              "priority": {
                "type": "string",
                "description": "Priority of the transition.",
                "enum": [
                  "normal",
                  "high"
                ]
              },
              "description": {
                "type": "string",
                "description": "Optional description of the transition."
              }
            },
            "additionalProperties": false
          }
        },
        "guards": {
          "type": "array",
          "description": "All guard definitions.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "evaluation"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique guard identifier.",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "description": "Human-readable description of what the guard checks."
              },
              "evaluation": {
                "type": "string",
                "description": "How the guard is evaluated (e.g. boolean expression, runtime check)."
              }
            },
            "additionalProperties": false
          }
        },
        "actions": {
          "type": "array",
          "description": "All action definitions.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "idempotent_key"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique action identifier.",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "description": "Human-readable description of what the action does."
              },
              "idempotent_key": {
                "type": "string",
                "description": "Template or expression for the idempotency key of this action."
              },
              "effects": {
                "type": "array",
                "description": "Side-effects of the action on Kanban or GitHub.",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "work_item_flow": {
          "type": "array",
          "description": "Ordered list of state ids representing the normal work item flow.",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "kanban_mapping": {
          "type": "object",
          "required": [
            "column_correspondence",
            "idempotency_key_template",
            "one_card_per_issue",
            "dispatch_approval"
          ],
          "properties": {
            "column_correspondence": {
              "type": "array",
              "description": "Mapping between state ids and Kanban columns.",
              "items": {
                "type": "object",
                "required": [
                  "state",
                  "column"
                ],
                "properties": {
                  "state": {
                    "type": "string"
                  },
                  "column": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "idempotency_key_template": {
              "type": "string",
              "description": "Template for idempotency keys (must include repo and issue number)."
            },
            "one_card_per_issue": {
              "type": "boolean",
              "description": "Whether exactly one card should exist per GitHub issue."
            },
            "dispatch_approval": {
              "type": "object",
              "description": "Pre-execution dispatch approval metadata required before a Ready item can be assigned. The object must define required fields, additionalProperties=false, and properties for approved_by, approved_at_utc, source, supervisory_run_id, and note."
            }
          },
          "additionalProperties": false
        },
        "dispatch_policy": {
          "type": "object",
          "required": [
            "wave_activation_source",
            "assignable_agent_criteria",
            "dependency_resolution",
            "wip_limits"
          ],
          "properties": {
            "wave_activation_source": {
              "type": "string",
              "description": "Who controls wave activation.",
              "const": "chatgpt_supervisor"
            },
            "assignable_agent_criteria": {
              "type": "array",
              "description": "Criteria that an agent must satisfy to be assignable.",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "dependency_resolution": {
              "type": "string",
              "description": "How dependencies are resolved before dispatch."
            },
            "wip_limits": {
              "type": "object",
              "required": [
                "in_progress_global",
                "in_progress_per_agent"
              ],
              "properties": {
                "in_progress_global": {
                  "type": "integer",
                  "minimum": 1
                },
                "in_progress_per_agent": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "dispatch_only_to_active_waves": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "supervisory_integration": {
          "type": "object",
          "required": [
            "disposition_mapping",
            "required_finding_effects"
          ],
          "properties": {
            "disposition_mapping": {
              "type": "object",
              "description": "Maps ChatGPT supervisor disposition values to target states.",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            },
            "required_finding_effects": {
              "type": "array",
              "description": "Effects of REQUIRED findings on work item flow.",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "conflict_resolution": {
          "type": "object",
          "required": [
            "branch_prefixes",
            "merge_policy"
          ],
          "properties": {
            "branch_prefixes": {
              "type": "object",
              "required": [
                "hermes",
                "chatgpt",
                "orchestrator"
              ],
              "properties": {
                "hermes": {
                  "type": "string"
                },
                "chatgpt": {
                  "type": "string"
                },
                "orchestrator": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "merge_policy": {
              "type": "array",
              "description": "Rules governing how branch conflicts are resolved.",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "retry_policy": {
          "type": "object",
          "required": [
            "max_attempts",
            "backoff_strategy",
            "base_delay_seconds",
            "max_delay_seconds",
            "timeout_seconds"
          ],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "backoff_strategy": {
              "type": "string"
            },
            "base_delay_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_delay_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "dead_letter": {
          "type": "object",
          "required": [
            "condition",
            "action",
            "notification_target"
          ],
          "properties": {
            "condition": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "notification_target": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "scenarios": {
          "type": "array",
          "description": "Normal, rework, block, recovery, defer, external-review, dead-letter, dependency-gated, and wave-gated scenario coverage.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "transitions"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "transitions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "runtime_compatibility": {
          "type": "object",
          "description": "Runtime compatibility and workaround declarations for Hermes versions.",
          "properties": {
            "hermes_v0_19": {
              "type": "object",
              "required": [
                "rich_transition_cli",
                "active_run_cancel_cli",
                "ready_auto_dispatches",
                "logical_dispatch_guard_enforced",
                "unblock_no_dispatch_supported",
                "physical_to_logical_mapping",
                "workarounds",
                "prohibitions"
              ],
              "properties": {
                "rich_transition_cli": {
                  "type": "boolean"
                },
                "active_run_cancel_cli": {
                  "type": "boolean"
                },
                "ready_auto_dispatches": {
                  "type": "boolean"
                },
                "logical_dispatch_guard_enforced": {
                  "type": "boolean"
                },
                "unblock_no_dispatch_supported": {
                  "type": "boolean"
                },
                "physical_to_logical_mapping": {
                  "type": "object"
                },
                "workarounds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "prohibitions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "findings_states": {
          "type": "array",
          "description": "Explicit supervisory finding lifecycle states.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}